{"id":"166c664bb3dd78b4","ref":"Sifrei Devarim 126","heRef":"ספרי דברים קכ״ו","group":"midrash","work":"Sifrei Devarim","chapter":2,"halakhah":13,"endHalakhah":13,"baseIdx":435,"endIdx":443,"precision":"span","tier":"single-source","numSources":1,"sources":["sifrei_devarim_finkelstein_apparatus"],"citations":["תוספתא מכשירין פ\"ג הי\"ד ( ע 676 )"],"citedRef":"3:14","citedScheme":"vilna","flags":[],"anchorText":"וְרַבִּי אֱלִיעֶזֶר אוֹמֵר: כָּל","targetSpan":[80,100],"matched":6,"density":0.667,"containment":0.103},{"id":"5dc10e0ad854a500","ref":"Tosefta Demai 1:10","heRef":"תוספתא דמאי א׳:י׳","group":"tosefta","work":"Tosefta","chapter":2,"halakhah":14,"endHalakhah":14,"baseIdx":491,"endIdx":519,"precision":"span","tier":"single-source","numSources":1,"sources":["sefaria_links"],"citations":["תוספתא מכשירין ג׳:ט׳"],"citedRef":"3:9","citedScheme":"vilna","flags":[],"anchorText":"יְהוֹשֻׁעַ בֶּן קבוסאי: כָּל","targetSpan":[80,112],"matched":19,"density":0.655,"containment":0.28}]},"texts":{"Sifrei Devarim 126":{"he":"שבגלוי ואינו חוזר, אף אין לי אלא מום שבגלוי ואינו חוזר. (דברים טו כג) רק את דמו לא תאכל, שתיה בכלל אכילה. רק – זו התרית עדים; רק – לתן שיעור כזית שאמרה תורה. על הארץ – ולא על העוקא, ולא על הגמא, לא על המים והנהרות המהלכים, אלא נכנס לתוך ביתו ושוחט חוץ לגמא, והדם שותת ויורד לתוך הגמא שלא יטנף את כל הבית. ובשוק לא יעשה כן, שלא יחקה את המינים. תשפכנו – אין שפיכה אלא מן הצואר. רבי אליעזר אומר: על הארץ תשפכנו כמים, מה מים מכשירים את הזרעים – אף דם שחיטה מכשיר את הזרעים. או דם נחירה, דם עקור, דם קלוח, דם הקזה, הטחול השליל והתמצית, הכבד הלב והמיתה במשמע? תלמוד לומר: תשפכנו כמים, מי שנשפך כמים הוא שמכשיר, יצאו אלו שאינם מכשירים.","heRef":"ספרי דברים קכ״ו","trimmedStart":true,"trimmedEnd":false},"Tosefta Demai 1:10":{"he":"מטילין לתוכו אם רוב נכרים ודאי ואם רוב ישראל דמאי מחצה על מחצה ודאי ד\"ר מאיר וחכ\"א אפילו כולם נכרים וישראל אחד מטיל לתוכו דמאי א\"ר יוסי בד\"א באוצר של יחיד אבל באוצר של מלכים הולכים אחר הרוב א\"ר יהודה בד\"א באוצר של ישראל ונכרים אבל אוצר ישראל וכותים הולכים אחר הרוב א\"ל [אחרי שהוריתה לנו] על אוצרות של יבנה שלפני מלחמה שהיא דמאי ורובן כותים אבל אוצר שמטיל בו מחו\"ל לארץ כגון אוצרות של [דנב] חייב לפי חשבון א\"ר יהושע בן קביסאי כל ימי הייתי קורא מקרא הזה (במדבר י״ט:י״ט) והזה הטהור על הטמא ולא מצא [ידיו] אלא באוצר של יבנה בלבד ומאוצרה של יבנה למדתי שטהור אחד מזה אפי' על מאה טמאים.","heRef":"תוספתא דמאי א׳:י׳","trimmedStart":true,"trimmedEnd":false},"Tosefta Terumot 9:8":{"he":"אין עושין את היין אלונתית ואת השמן ערב [ואם עשה את היין אלונתית ואת השמן ערב] סך את השמן ואין סך יין [וחומץ] השמן דרכו לסיכה יין [וחומץ] אין דרכן לסיכה.","heRef":"תוספתא תרומות ט׳:ח׳"},"Tosefta Shabbat 15:4":{"he":"מטלטלין את המשליא להעלות בה דלי או קיתון כלכלה לישב עליה תרנגולת בהמה שנפלה לתוך הבור עושין לה פרנסה במקומה בשביל שלא תמות.","heRef":"תוספתא שבת ט״ו:ד׳"}}}